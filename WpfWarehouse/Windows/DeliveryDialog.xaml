<Window x:Class="WpfWarehouse.Windows.DeliveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поставка" 
        Height="600" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Информация о поставке" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Товар -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Товар:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="ProductComboBox" 
                      DisplayMemberPath="title" 
                      SelectedValuePath="id"
                      Height="35"/>
            <TextBlock x:Name="ProductError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Дата поставки -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Дата поставки:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DatePicker x:Name="DatePicker" Height="35" SelectedDateFormat="Short"/>
            <TextBlock x:Name="DateError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Количество -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Количество:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="QuantityBox" Height="35" Padding="5"/>
            <TextBlock x:Name="QuantityError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Цена за единицу -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Цена за единицу:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="CostBox" Height="35" Padding="5"/>
            <TextBlock x:Name="CostError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Итоговая сумма -->
        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock FontWeight="Bold" FontSize="14">
                Итоговая сумма: <Run x:Name="TotalText" Text="0" Foreground="#667eea"/>
            </TextBlock>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="OK" Click="Ok_Click" Width="80" Height="35" Margin="5"
                    Style="{StaticResource ActionButtonStyle}" Background="#27AE60"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="80" Height="35" Margin="5"
                    Style="{StaticResource ActionButtonStyle}" Background="#95A5A6"/>
        </StackPanel>
    </Grid>
</Window>