<Window x:Class="WpfWarehouse.Windows.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" 
        Height="620" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Информация о товаре" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Название -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Название:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="TitleBox" Height="35" Padding="5"/>
            <TextBlock x:Name="TitleError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Цена -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Цена:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="PriceBox" Height="35" Padding="5"/>
            <TextBlock x:Name="PriceError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Количество -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Количество:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="QuantityBox" Height="35" Padding="5"/>
            <TextBlock x:Name="QuantityError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Категория -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Категория:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CategoryComboBox" 
                      DisplayMemberPath="title" 
                      SelectedValuePath="id"
                      Height="35"/>
            <TextBlock x:Name="CategoryError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Поставщик -->
        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock Text="Поставщик:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="SupplierComboBox" 
                      DisplayMemberPath="name" 
                      SelectedValuePath="id"
                      Height="35"/>
            <TextBlock x:Name="SupplierError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="OK" Click="Ok_Click" Width="80" Height="35" Margin="5"
                    Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="80" Height="35" Margin="5"
                    Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>