<Window x:Class="WpfWarehouse.Windows.SupplierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поставщик" 
        Height="530" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Информация о поставщике" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Название -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Название:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="NameBox" Height="35" Padding="5"/>
            <TextBlock x:Name="NameError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Контактное лицо -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Контактное лицо:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="ContactBox" Height="35" Padding="5"/>
            <TextBlock x:Name="ContactError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Телефон -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Телефон:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="PhoneBox" Height="35" Padding="5"/>
            <TextBlock x:Name="PhoneError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Email -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox" Height="35" Padding="5"/>
            <TextBlock x:Name="EmailError" Foreground="Red" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="OK" Click="Ok_Click" Width="80" Height="35" Margin="5"
                    Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="80" Height="35" Margin="5"
                    Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>