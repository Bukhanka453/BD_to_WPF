<Window x:Class="WpfWarehouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление складом" 
        Height="500" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                Padding="20" 
                CornerRadius="10" 
                Margin="0,0,0,30">
            <TextBlock Text="🏪 Система управления складом" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Кнопки меню -->
        <WrapPanel Grid.Row="1" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center">
            <Button Content="📁 Категории" 
                    Click="Categories_Click" 
                    Style="{StaticResource NavButtonStyle}" 
                    Margin="10" Width="180"/>

            <Button Content="🏢 Поставщики" 
                    Click="Suppliers_Click" 
                    Style="{StaticResource NavButtonStyle}" 
                    Margin="10" Width="180"/>

            <Button Content="📦 Товары" 
                    Click="Products_Click" 
                    Style="{StaticResource NavButtonStyle}" 
                    Margin="10" Width="180"/>
            
            <Button Content="🚚 Поставки" 
                    Click="Deliveries_Click" 
                    Style="{StaticResource NavButtonStyle}" 
                    Margin="10" Width="180"/>

            <Button Content="❌ Выход" 
                    Click="Exit_Click" 
                    Style="{StaticResource NavButtonStyle}" 
                    Margin="10" Width="180" 
                    Background="#E74C3C"/>
        </WrapPanel>
    </Grid>
</Window>